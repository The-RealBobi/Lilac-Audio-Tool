<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Level5.AudioTool.Gui"
        x:Class="Level5.AudioTool.Gui.MainWindow"
        Width="1280"
        Height="820"
        MinWidth="1100"
        MinHeight="720"
        Title="Lilac Audio Tool"
        Icon="/Assets/icon.ico"
        DragDrop.AllowDrop="True">
  <Grid Margin="18" RowDefinitions="Auto,*,Auto" RowSpacing="14">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10">
      <TextBlock Text="Lilac Audio Tool" FontSize="28" FontWeight="Bold" VerticalAlignment="Center" />
      <ComboBox x:Name="LanguageComboBox"
                Grid.Column="1"
                Width="115"
                VerticalAlignment="Center"
                SelectedIndex="0"
                SelectionChanged="OnLanguageChanged">
        <ComboBoxItem Content="English" />
        <ComboBoxItem Content="Español" />
      </ComboBox>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" MinWidth="245" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="*" MinWidth="200" />
        <ColumnDefinition Width="12" />
        <ColumnDefinition Width="360" MinWidth="285" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Padding="14" CornerRadius="10" Background="#101C1C1C">
        <StackPanel Spacing="8">
          <TextBlock x:Name="FilesHeaderTextBlock" Text="Bank" FontWeight="SemiBold" />
          <Button x:Name="BrowseBankButton"
                  Content="Open ACB/AWB"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Click="OnBrowseBankClick" />
          <TextBox x:Name="WavPathTextBox" IsVisible="False" IsReadOnly="True" />
          <TextBox x:Name="OutputDirectoryTextBox" IsVisible="False" IsReadOnly="True" />
        </StackPanel>
      </Border>

      <GridSplitter Grid.Column="1"
                    Width="8"
                    Margin="1,0"
                    Background="#304F807D"
                    ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext"
                    ShowsPreview="True"
                    Cursor="SizeWestEast" />

      <Border Grid.Column="2" Padding="14" CornerRadius="10" Background="#101C1C1C">
        <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
          <WrapPanel ItemSpacing="8" LineSpacing="6">

            <Button x:Name="PreviewEntryButton"
                    Content="Play"
                    Click="OnPreviewEntryClick" />
            <Button x:Name="AddEntryButton"
                    Content="New entry"
                    Click="OnAddEntryClick" />
            <Button x:Name="ExportEntriesButton"
                    Content="Export WAV"
                    Click="OnExportEntriesClick" />
          </WrapPanel>

          <Border Grid.Row="1" x:Name="SelectedEntryDetails" IsVisible="False" Padding="10" CornerRadius="6" Background="#14282929">
            <TextBlock x:Name="SelectedEntryTextBlock"
                       TextWrapping="Wrap" />
          </Border>

          <WrapPanel Grid.Row="2" ItemSpacing="8" LineSpacing="6">

            <ComboBox x:Name="SelectorModeComboBox" SelectedIndex="0" SelectionChanged="OnSelectorChanged">
              <ComboBoxItem Content="ID AWB" />
              <ComboBoxItem Content="Index" />
            </ComboBox>
            <NumericUpDown x:Name="EntryNumberBox"
                           Width="110"
                           Minimum="0"
                           Maximum="999999"
                           Increment="1"
                           Value="0"
                           ValueChanged="OnSelectorNumberChanged" />
            <Button x:Name="SubstituteButton"
                    Content="Replace"
                    Click="OnSubstituteClick" />
            <Button x:Name="RenameEntryButton"
                    Content="Rename"
                    Click="OnRenameEntryClick" />
            <Button x:Name="DeleteEntryButton"
                    Content="Delete"
                    Click="OnDeleteEntryClick" />
          </WrapPanel>

          <DataGrid Grid.Row="3"
                    x:Name="AwbEntriesGrid"
                    SelectionMode="Extended"
                    RowHeight="34"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserResizeColumns="True"
                    GridLinesVisibility="Horizontal"
                    PointerPressed="OnAwbEntriesPointerPressed"
                    SelectionChanged="OnAwbEntrySelectionChanged">
            <DataGrid.ContextMenu>
              <ContextMenu>
                <MenuItem x:Name="ContextExportEntriesItem" Header="Export WAV" Click="OnExportEntriesClick" />
                <MenuItem x:Name="ContextSubstituteItem" Header="Replace" Click="OnSubstituteClick" />
                <MenuItem x:Name="ContextRenameItem" Header="Rename" Click="OnRenameEntryClick" />
                <MenuItem x:Name="ContextDeleteItem" Header="Delete" Click="OnDeleteEntryClick" />
              </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Index" Binding="{Binding Index}" Width="74" MinWidth="56" />
              <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="74" MinWidth="56" />
              <DataGridTextColumn Header="Type" Binding="{Binding Extension}" Width="78" MinWidth="62" />
              <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="102" MinWidth="78" />
              <DataGridTemplateColumn Header="Name" Width="2*" MinWidth="180">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border ClipToBounds="True">
                      <TextBlock Text="{Binding PrimaryCue}"
                                 TextTrimming="CharacterEllipsis"
                                 TextWrapping="NoWrap"
                                 VerticalAlignment="Center"
                                 ToolTip.Tip="{Binding CueTooltip}" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Uses" Binding="{Binding CueReferenceSummary}" Width="72" MinWidth="54" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="3"
                    Width="8"
                    Margin="1,0"
                    Background="#304F807D"
                    ResizeDirection="Columns"
                    ResizeBehavior="PreviousAndNext"
                    ShowsPreview="True"
                    Cursor="SizeWestEast" />

      <Grid Grid.Column="4" RowDefinitions="Auto,12,210,12,*">
        <Border Grid.Row="0" Padding="14" CornerRadius="10" Background="#101C1C1C">
          <StackPanel Spacing="10">

            <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
              <ComboBox x:Name="LoopModeComboBox"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="0"
                        SelectionChanged="OnLoopModeChanged">
                <ComboBoxItem Content="File loop" />
                <ComboBoxItem Content="Manual" />
                <ComboBoxItem Content="No loop" />
              </ComboBox>
              <WrapPanel Grid.Row="1" ItemSpacing="8" LineSpacing="6">
                <Button x:Name="UseWavLoopButton"
                        Content="Use original loop"
                        HorizontalContentAlignment="Center"
                        Click="OnUseWavLoopClick" />
                <Button x:Name="PreviewLoopButton"
                        Content="Play loop"
                        HorizontalContentAlignment="Center"
                        Click="OnPreviewLoopClick" />
              </WrapPanel>
            </Grid>
            <TextBlock x:Name="LoopSummaryTextBlock"
                       IsVisible="False"
                       Opacity="0.75"
                       TextWrapping="Wrap" />
            <Grid ColumnDefinitions="44,*" ColumnSpacing="10">
              <Button x:Name="PlaybackButton"
                      Width="40"
                      Height="74"
                      Content="▶"
                      FontSize="16"
                      Click="OnPlaybackToggleClick" />
              <local:PlaybackTimeline Grid.Column="1"
                                      x:Name="LoopTimeline"
                                      Height="74"
                                      PointerPressed="OnLoopTimelinePointerPressed"
                                      PointerMoved="OnLoopTimelinePointerMoved"
                                      PointerReleased="OnLoopTimelinePointerReleased"
                                      PointerCaptureLost="OnLoopTimelinePointerCaptureLost"
                                      SizeChanged="OnLoopTimelineSizeChanged" />
            </Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
              <NumericUpDown x:Name="LoopStartBox"
                             Minimum="0"
                             Maximum="0"
                             Increment="1"
                             ValueChanged="OnLoopNumberChanged" />
              <NumericUpDown Grid.Column="1"
                             x:Name="LoopEndBox"
                             Minimum="0"
                             Maximum="0"
                             Increment="1"
                             ValueChanged="OnLoopNumberChanged" />
            </Grid>
          </StackPanel>
        </Border>

        <GridSplitter Grid.Row="1"
                      Height="8"
                      Margin="0,1"
                      Background="#304F807D"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      ShowsPreview="True"
                      Cursor="SizeNorthSouth" />

        <Border Grid.Row="2" Padding="14" CornerRadius="10" Background="#101C1C1C">
          <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
            <WrapPanel ItemSpacing="8" LineSpacing="6">

              <Button x:Name="RemoveReplacementButton"
                      Content="Remove"
                      Click="OnRemoveReplacementClick" />
              <Button x:Name="ClearReplacementsButton"
                      Content="Clear"
                      Click="OnClearReplacementsClick" />
            </WrapPanel>
            <TextBlock Grid.Row="1"
                       x:Name="CommandPreviewTextBlock"
                       Text="No command prepared."
                       Opacity="0.75"
                       TextWrapping="Wrap" />
            <DataGrid Grid.Row="2"
                      x:Name="ReplacementQueueGrid"
                      RowHeight="32"
                      AutoGenerateColumns="False"
                      IsReadOnly="False"
                      CanUserResizeColumns="True"
                      GridLinesVisibility="Horizontal"
                      BeginningEdit="OnReplacementBeginningEdit"
                      CellEditEnded="OnReplacementCellEditEnded"
                      SelectionChanged="OnReplacementSelectionChanged">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="72" MinWidth="58" IsReadOnly="True" />
                <DataGridTextColumn Header="Entry" Binding="{Binding Entry, Mode=TwoWay}" Width="92" MinWidth="72" />
                <DataGridTemplateColumn Header="Audio" Width="*" MinWidth="170" IsReadOnly="True">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border ClipToBounds="True">
                        <TextBlock Text="{Binding AudioName}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   VerticalAlignment="Center"
                                   ToolTip.Tip="{Binding AudioPath}" />
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>

        <GridSplitter Grid.Row="3"
                      Height="8"
                      Margin="0,1"
                      Background="#304F807D"
                      ResizeDirection="Rows"
                      ResizeBehavior="PreviousAndNext"
                      ShowsPreview="True"
                      Cursor="SizeNorthSouth" />

        <Border Grid.Row="4" Padding="14" CornerRadius="10" Background="#101C1C1C">
          <Grid RowDefinitions="Auto,*" RowSpacing="10">
            <TextBlock x:Name="OperationHeaderTextBlock" Text="Log" FontWeight="SemiBold" />
            <TextBox Grid.Row="1"
                     x:Name="LogTextBox"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />
          </Grid>
        </Border>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Padding="14,8" CornerRadius="10" Background="#16232424">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <WrapPanel ItemSpacing="14" LineSpacing="6" VerticalAlignment="Center">
          <TextBlock x:Name="ExportOptionsHeaderTextBlock" Text="Export options" FontWeight="SemiBold" VerticalAlignment="Center" />
          <CheckBox x:Name="KeepHcaCheckBox" Content="Keep encoded audio next to the AWB" IsChecked="False" />
          <CheckBox x:Name="KeepReportsCheckBox" Content="Keep export reports" IsChecked="False" />
          <CheckBox x:Name="UseModSuffixCheckBox" Content="Append .mod suffix" IsChecked="False" />
        </WrapPanel>
        <Button Grid.Column="1" x:Name="ExecuteButton" Content="Export" Padding="22,10"
                VerticalAlignment="Center" Click="OnExecuteClick" />
      </Grid>
    </Border>
  </Grid>
</Window>
